+/* IT files are little-endian: fields read whole into the structs below are
+   put into the host's order (nothing to do on a little-endian host). */
+static uint16_t sackit_le16(uint16_t v)
+{
+	const uint8_t *b = (const uint8_t *)&v;
+	return (uint16_t)(b[0] | (b[1] << 8));
+}
+
+static uint32_t sackit_le32(uint32_t v)
+{
+	const uint8_t *b = (const uint8_t *)&v;
+	return (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+}
